<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Virtual IoT Menu -->
    <menuitem id="menu_virtual_iot_main" 
              name="Virtual IoT" 
              sequence="100" 
              web_icon="virtual_iot_connector,static/description/icon.png"/>

    <!-- Devices Submenu -->
    <menuitem id="menu_virtual_iot_devices" 
              name="Devices" 
              parent="menu_virtual_iot_main" 
              action="action_virtual_iot_device" 
              sequence="10"/>

    <!-- Printers Submenu -->
    <menuitem id="menu_virtual_iot_printers" 
              name="Printers" 
              parent="menu_virtual_iot_main" 
              action="action_virtual_iot_printer" 
              sequence="20"/>

    <!-- Print Jobs Submenu -->
    <menuitem id="menu_virtual_iot_print_jobs" 
              name="Print Jobs" 
              parent="menu_virtual_iot_main" 
              action="action_virtual_iot_print_job" 
              sequence="30"/>

    <!-- Configuration Submenu -->
    <menuitem id="menu_virtual_iot_config" 
              name="Configuration" 
              parent="menu_virtual_iot_main" 
              sequence="40"/>

    <!-- POS Configuration under Configuration -->
    <menuitem id="menu_virtual_iot_pos_config" 
              name="POS Configuration" 
              parent="menu_virtual_iot_config" 
              action="point_of_sale.action_pos_configuration" 
              sequence="10"/>

    <!-- Settings under Configuration -->
    <record id="action_virtual_iot_settings" model="ir.actions.act_window">
        <field name="name">Virtual IoT Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'virtual_iot_connector'}</field>
    </record>

    <menuitem id="menu_virtual_iot_settings" 
              name="Settings" 
              parent="menu_virtual_iot_config" 
              action="action_virtual_iot_settings" 
              sequence="20"/>

    <!-- Dashboard Action -->
    <record id="action_virtual_iot_dashboard" model="ir.actions.client">
        <field name="name">Virtual IoT Dashboard</field>
        <field name="tag">virtual_iot_dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- Dashboard Menu -->
    <menuitem id="menu_virtual_iot_dashboard"
              name="Dashboard"
              parent="menu_virtual_iot_main"
              action="action_virtual_iot_dashboard"
              sequence="1"/>
</odoo>
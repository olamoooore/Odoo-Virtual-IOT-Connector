<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4CAF50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2196F3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background circle -->
  <circle cx="32" cy="32" r="30" fill="url(#grad1)" stroke="#fff" stroke-width="2"/>
  
  <!-- IoT Device (Server) -->
  <rect x="20" y="15" width="24" height="16" rx="2" fill="#fff" opacity="0.9"/>
  <rect x="22" y="17" width="20" height="2" fill="#333"/>
  <rect x="22" y="20" width="20" height="2" fill="#333"/>
  <rect x="22" y="23" width="20" height="2" fill="#333"/>
  <rect x="22" y="26" width="20" height="2" fill="#333"/>
  
  <!-- Printer -->
  <rect x="18" y="38" width="28" height="12" rx="2" fill="#fff" opacity="0.9"/>
  <rect x="20" y="40" width="24" height="2" fill="#333"/>
  <rect x="20" y="43" width="24" height="2" fill="#333"/>
  <rect x="20" y="46" width="24" height="2" fill="#333"/>
  
  <!-- Paper coming out -->
  <rect x="24" y="50" width="16" height="6" rx="1" fill="#fff" stroke="#333" stroke-width="1"/>
  <line x1="26" y1="52" x2="38" y2="52" stroke="#333" stroke-width="1"/>
  <line x1="26" y1="54" x2="38" y2="54" stroke="#333" stroke-width="1"/>
  
  <!-- Connection lines -->
  <line x1="32" y1="31" x2="32" y2="38" stroke="#fff" stroke-width="2"/>
  <circle cx="32" cy="34.5" r="1.5" fill="#fff"/>
  
  <!-- WiFi signal -->
  <path d="M 8 20 Q 12 16 16 20" stroke="#fff" stroke-width="2" fill="none"/>
  <path d="M 10 22 Q 12 20 14 22" stroke="#fff" stroke-width="2" fill="none"/>
  <circle cx="12" cy="24" r="1" fill="#fff"/>
  
  <!-- Print icon -->
  <path d="M 48 20 Q 52 16 56 20" stroke="#fff" stroke-width="2" fill="none"/>
  <path d="M 50 22 Q 52 20 54 22" stroke="#fff" stroke-width="2" fill="none"/>
  <circle cx="52" cy="24" r="1" fill="#fff"/>
</svg>